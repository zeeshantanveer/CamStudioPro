<Window x:Class="EditorHarness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:CamStudio.Editor;assembly=CamStudio.Editor"
        Title="Editor harness" Width="1400" Height="900" Background="{DynamicResource Ground}"
        FontFamily="{DynamicResource Sans}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="8">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="ThemeButton" Style="{DynamicResource BaseButton}" Content="Switch to light" Click="Theme_Click"/>
        <TextBlock Text="Harness for CamStudio.Editor" Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
    </Border>
    <editor:EditorView x:Name="Editor"/>
  </DockPanel>
</Window>
