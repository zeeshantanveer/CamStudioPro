<Project Sdk="Microsoft.NET.Sdk">
  <!-- Visual test host for CamStudio.Editor with the desktop app's real theme dictionaries. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Page Include="..\..\src\CamStudio.Desktop\Themes\Dark.xaml" Link="Themes\Dark.xaml" />
    <Page Include="..\..\src\CamStudio.Desktop\Themes\Light.xaml" Link="Themes\Light.xaml" />
    <Page Include="..\..\src\CamStudio.Desktop\Themes\Controls.xaml" Link="Themes\Controls.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CamStudio.Editor/CamStudio.Editor.csproj" />
  </ItemGroup>
</Project>
