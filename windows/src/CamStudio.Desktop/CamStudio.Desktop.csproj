<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CamStudio.Desktop</RootNamespace>
    <AssemblyName>CamStudioPro</AssemblyName>
    <Product>CamStudio Pro</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Assets\studio-mic-mesh.png;Assets\studio-mic-foam.png" LogicalName="CamStudio.Desktop.Assets.%(Filename)%(Extension)" />
    <Content Include="..\..\THIRD-PARTY-VCamSample-LICENSE.txt" Link="THIRD-PARTY-VCamSample-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\CamStudio.VCam.Native\THIRD-PARTY-WIL-LICENSE.txt" Link="THIRD-PARTY-WIL-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-AUDIO-LICENSES.txt" Link="THIRD-PARTY-AUDIO-LICENSES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CamStudio.Editor\CamStudio.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DirectNCore" Version="1.18.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="YellowDogMan.RRNoise.NET" Version="0.1.9" />
  </ItemGroup>

  <Target Name="BuildNativeCamera" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(Platform)' == 'ARM64'" Text="The native camera currently supports x64 builds only." />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\build-native-camera.ps1&quot; -Configuration $(Configuration)" />
  </Target>
  <Target Name="CopyVirtualCamera" AfterTargets="Build">
    <ItemGroup><CameraFiles Include="$(MSBuildProjectDirectory)\..\CamStudio.VCam.Native\bin\x64\$(Configuration)\CamStudio.VCam.Native.dll" /></ItemGroup>
    <Copy SourceFiles="@(CameraFiles)" DestinationFolder="$(TargetDir)VCam" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishVirtualCamera" AfterTargets="Publish">
    <ItemGroup><PublishedCameraFiles Include="$(TargetDir)VCam\CamStudio.VCam.Native.dll" /></ItemGroup>
    <Copy SourceFiles="@(PublishedCameraFiles)" DestinationFolder="$(PublishDir)VCam" />
  </Target>
</Project>

