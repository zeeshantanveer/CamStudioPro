<Window x:Class="CamStudio.Desktop.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Allow this phone?" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource Text}" FontFamily="{DynamicResource Sans}"
        Icon="Assets/app.ico">
  <StackPanel Margin="24">
    <TextBlock Text="A phone wants to stream to this PC" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
    <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
      <StackPanel>
        <TextBlock x:Name="PhoneName" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="PhoneDetail" Style="{StaticResource Body}" Margin="0,3,0,0"/>
      </StackPanel>
    </Border>
    <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0"
               Text="Allow it only if it is your phone. Allowed phones are remembered and connect without asking."/>
    <TextBlock x:Name="Countdown" Style="{StaticResource Body}" Margin="0,6,0,0"/>
    <UniformGrid Columns="2" Margin="0,18,0,0">
      <Button Content="Deny" Style="{StaticResource BaseButton}" MinHeight="44" Margin="0,0,6,0" Click="Deny_Click" IsCancel="True"/>
      <Button Content="Allow" Style="{StaticResource PrimaryButton}" MinHeight="44" Margin="6,0,0,0" Click="Allow_Click" IsDefault="True"/>
    </UniformGrid>
  </StackPanel>
</Window>
