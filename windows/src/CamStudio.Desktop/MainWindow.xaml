<Window x:Class="CamStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CamStudio Pro" Width="1280" Height="820" MinWidth="1000" MinHeight="660"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource Sans}" WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style x:Key="LiveAction" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,4"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LiveSubtleAction" TargetType="Button" BasedOn="{StaticResource LiveAction}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="LiveStopAction" TargetType="Button" BasedOn="{StaticResource LiveAction}">
      <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>
    <Style x:Key="LiveCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="LiveStatus" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Style.Triggers>
        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="SettingRow" TargetType="Grid">
      <Setter Property="MinHeight" Value="44"/>
    </Style>
    <Style x:Key="SettingsHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
      <Setter Property="Margin" Value="2,24,0,10"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============ navigation rail ============ -->
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Viewbox DockPanel.Dock="Top" Width="36" Height="36" Margin="0,16,0,20" ToolTip="CamStudio Pro">
          <Canvas Width="34" Height="34">
            <Rectangle Width="34" Height="34" RadiusX="10" RadiusY="10" Fill="{DynamicResource CardRaised}" Stroke="{DynamicResource Line}"/>
            <Ellipse Canvas.Left="8" Canvas.Top="8" Width="18" Height="18" Stroke="{DynamicResource Accent}" StrokeThickness="2"/>
            <Ellipse Canvas.Left="13.5" Canvas.Top="13.5" Width="7" Height="7" Fill="{DynamicResource Accent}"/>
          </Canvas>
        </Viewbox>
        <StackPanel DockPanel.Dock="Top">
          <RadioButton x:Name="NavLive" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE714;" Content="Live" IsChecked="True"
                       Checked="Nav_Checked" ToolTip="Live camera (Ctrl+1)"/>
          <RadioButton x:Name="NavEditor" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE8B2;" Content="Editor"
                       Checked="Nav_Checked" ToolTip="Video editor (Ctrl+2)"/>
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE713;" Content="Settings"
                       Checked="Nav_Checked" ToolTip="Settings (Ctrl+3)"/>
        </StackPanel>
        <Ellipse x:Name="RailStatusDot" DockPanel.Dock="Bottom" Width="8" Height="8" Margin="0,0,0,20" VerticalAlignment="Bottom"
                 Fill="{DynamicResource Accent}" ToolTip="Phone status"/>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ============ header ============ -->
      <DockPanel Margin="24,14,24,14" LastChildFill="False">
        <TextBlock x:Name="PageTitle" DockPanel.Dock="Left" Text="Live" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        <Button x:Name="CameraToggleButton" DockPanel.Dock="Right" Content="Open camera" Style="{StaticResource LiveAction}"
                Click="CameraToggle_Click" Margin="12,0,0,0" IsEnabled="False"/>
        <Border x:Name="StatusPill" DockPanel.Dock="Right" CornerRadius="14" Padding="12,0" Height="28" Background="{DynamicResource Card}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Waiting for a phone" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="PcNameText" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"
                   ToolTip="This computer's name, shown on the phone"/>
      </DockPanel>

      <!-- ============ LIVE ============ -->
      <Grid x:Name="LivePage" Grid.Row="1" Margin="24,0,24,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border CornerRadius="14" Background="{DynamicResource PreviewBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                     AutomationProperties.Name="Live preview from the phone"/>
              <StackPanel x:Name="PreviewOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <Border Width="64" Height="64" CornerRadius="18" Background="#1E2127" HorizontalAlignment="Center">
                  <Grid Width="30" Height="30">
                    <Ellipse Stroke="#FFB020" StrokeThickness="3"/>
                    <Ellipse Width="11" Height="11" Fill="#FFB020"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="PreviewTitle" Text="No phone connected" Foreground="#F3F4F6" FontFamily="{StaticResource Display}"
                           FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,20,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="PreviewDetail" Text="Open CamStudio Pro on your phone, then tap Connect." Foreground="#A9AFB9"
                           FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
                <Border x:Name="LiveBadge" CornerRadius="6" Background="{DynamicResource Live}" Padding="9,4" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveText" Text="LIVE 00:00:00" Foreground="White" FontFamily="{StaticResource Mono}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"/>
                  </StackPanel>
                </Border>
                <Border x:Name="ShareBadge" CornerRadius="6" Background="#CC000000" Padding="9,4" Margin="8,0,0,0" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#FFB020" VerticalAlignment="Center"/>
                    <TextBlock Text="SCREEN" Foreground="White" FontFamily="{StaticResource Mono}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"/>
                  </StackPanel>
                </Border>
                <Border x:Name="RecBadge" CornerRadius="6" Background="#CC000000" Padding="9,4" Margin="8,0,0,0" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#FF4D4F" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RecText" Text="REC 00:00:00" Foreground="White" FontFamily="{StaticResource Mono}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <Border x:Name="PhoneBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" CornerRadius="6"
                      Background="#B8000000" Padding="9,4" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Fill="#4ADE80" VerticalAlignment="Center"/>
                  <TextBlock x:Name="PhoneBadgeText" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" Foreground="White"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- stats -->
          <Border Grid.Row="1" Style="{StaticResource LiveCard}" Margin="0,12,0,0" Padding="4,10">
            <UniformGrid Rows="1">
              <StackPanel Margin="12,0">
                <TextBlock Text="Delay" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="DelayText" Text="—" Style="{StaticResource StatValue}"/>
              </StackPanel>
              <StackPanel Margin="12,0">
                <TextBlock Text="Frame rate" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="FpsText" Text="—" Style="{StaticResource StatValue}"/>
              </StackPanel>
              <StackPanel Margin="12,0">
                <TextBlock Text="Bitrate" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="BitrateText" Text="—" Style="{StaticResource StatValue}"/>
              </StackPanel>
              <StackPanel Margin="12,0">
                <TextBlock Text="Dropped" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="DroppedText" Text="—" Style="{StaticResource StatValue}"/>
              </StackPanel>
              <StackPanel Margin="12,0">
                <TextBlock Text="Resolution" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="ResolutionText" Text="—" Style="{StaticResource StatValue}"/>
              </StackPanel>
            </UniformGrid>
          </Border>

          <!-- action bar -->
          <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Margin="2,0,0,0">
              <TextBlock x:Name="PhoneDetailText" Style="{StaticResource LiveStatus}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         Margin="0,6,0,0"
                         Text=""/>
              <WrapPanel x:Name="RecordingResultPanel" Margin="0,4,0,0" Visibility="Collapsed">
                <TextBlock x:Name="RecordingStatusText" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           MaxWidth="360" VerticalAlignment="Center"/>
                <Button x:Name="EditRecordingButton" Content="Edit" Style="{StaticResource LiveSubtleAction}" Margin="12,0,0,0"
                        Click="EditRecording_Click" ToolTip="Open this recording in the editor"/>
                <Button Content="Show in folder" Style="{StaticResource LiveSubtleAction}" Margin="12,0,0,0" Click="OpenRecordings_Click"/>
              </WrapPanel>
            </StackPanel>
            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
              <CheckBox x:Name="MirrorToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Margin="0,0,16,0"
                        Checked="Mirror_Changed" Unchecked="Mirror_Changed" Content="Mirror"
                        ToolTip="Flip the preview horizontally. Recordings stay unmirrored."/>
              <Button x:Name="ShareButton" Style="{StaticResource LiveAction}" MinHeight="34" Padding="11,0" Margin="0,0,8,0"
                      AutomationProperties.Name="{Binding Text, ElementName=ShareButtonLabel}"
                      Click="ShareToggle_Click" ToolTip="Share a screen or window (Ctrl+Shift+S)">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ShareButtonLabel" Text="Share screen" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="GoLiveButton" Style="{StaticResource LiveAction}" MinHeight="34" Padding="11,0" Margin="0,0,8,0"
                      AutomationProperties.Name="{Binding Text, ElementName=GoLiveLabel}"
                      Click="GoLive_Click" ToolTip="Stream the current scene">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE93E;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center"/>
                  <TextBlock x:Name="GoLiveLabel" Text="Start stream" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="PauseRecordingButton" Content="Pause" Style="{StaticResource LiveAction}" MinHeight="34"
                      Margin="0,0,8,0" Click="PauseRecording_Click" Visibility="Collapsed"
                      ToolTip="Pause the saved recording" AutomationProperties.Name="Pause recording"/>
              <Button x:Name="RecordButton" Style="{StaticResource LiveAction}" MinHeight="34" Padding="11,0" Click="Record_Click" IsEnabled="False"
                      AutomationProperties.Name="{Binding Text, ElementName=RecordLabel}" ToolTip="Record the current scene">
                <StackPanel Orientation="Horizontal">
                  <Rectangle x:Name="RecordGlyph" RadiusX="5" RadiusY="5" Width="10" Height="10" Fill="{DynamicResource Danger}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="RecordLabel" Text="Record" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="DisconnectButton" Content="Disconnect" Style="{StaticResource LiveSubtleAction}" MinHeight="34" Padding="11,0"
                      Margin="8,0,0,0" Click="Disconnect_Click" IsEnabled="False"/>
            </WrapPanel>
          </Grid>
        </Grid>

        <!-- side panel -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" PanningMode="VerticalOnly" Padding="0,0,4,0">
          <StackPanel>

            <!-- live stream (YouTube / RTMP) -->
            <Border x:Name="StreamCard" Style="{StaticResource LiveCard}" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="StreamEditButton" DockPanel.Dock="Right" Content="Edit" Style="{StaticResource LiveSubtleAction}"
                          VerticalAlignment="Center" Click="StreamEdit_Click"/>
                  <Button DockPanel.Dock="Right" Content="Logs" Style="{StaticResource LiveSubtleAction}" Margin="0,0,14,0"
                          VerticalAlignment="Center" Click="StreamLogs_Click"
                          ToolTip="Per-second stream health (CSV) and the stream log, for diagnosing a broadcast"/>
                  <TextBlock Text="Live stream" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="StreamStatusText" Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Not set up"/>
                <StackPanel x:Name="YouTubeBroadcastPanel" Visibility="Collapsed" Margin="0,8,0,0">
                  <TextBlock Text="Confirm the broadcast is live in YouTube Studio." Style="{StaticResource Caption}"/>
                  <Button Content="Open YouTube Studio" Style="{StaticResource LiveAction}" HorizontalAlignment="Left"
                          Margin="0,6,0,0" Click="OpenYouTubeStudio_Click"/>
                </StackPanel>
                <StackPanel x:Name="StreamViewerPanel" Visibility="Collapsed" Margin="0,10,0,0">
                  <TextBlock Text="Viewer link" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                  <TextBox x:Name="StreamViewerLinkBox" IsReadOnly="True" AutomationProperties.Name="Viewer link"/>
                  <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="StreamViewerCopyButton" Content="Copy link" Style="{StaticResource LiveAction}" Click="CopyStreamViewer_Click" Margin="0,0,8,0"/>
                    <Button x:Name="StreamViewerOpenButton" Content="Open" Style="{StaticResource LiveSubtleAction}" Click="OpenStreamViewer_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="StreamViewerHint" Style="{StaticResource LiveStatus}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel x:Name="StreamSetupPanel" Margin="0,12,0,0" Visibility="Collapsed">
                  <TextBlock Text="Stream key" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                  <PasswordBox x:Name="StreamKeyBox" AutomationProperties.Name="Stream key"
                               ToolTip="YouTube Studio › Go live › Stream › Stream key"/>
                  <TextBlock Text="Server URL" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                  <TextBox x:Name="StreamUrlBox" AutomationProperties.Name="Server URL" FontFamily="{StaticResource Mono}" FontSize="12"/>
                  <TextBlock Text="Viewer link (for sharing)" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                  <TextBox x:Name="StreamViewerUrlBox" AutomationProperties.Name="Broadcast viewer link"/>
                  <TextBlock Text="Paste the broadcast watch link." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                  <TextBlock Text="Quality" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                  <ComboBox x:Name="StreamQualityCombo" AutomationProperties.Name="Stream quality">
                    <ComboBoxItem Content="Auto" Tag="Auto" ToolTip="YouTube holds quality once connected and lowers it if the upload cannot keep up."/>
                    <ComboBoxItem Content="4K ·" ToolTip="About 25 Mbps upload" Tag="4K"/>
                    <ComboBoxItem Content="1440p ·" ToolTip="About 11 Mbps upload" Tag="1440p"/>
                    <ComboBoxItem Content="1080p ·" ToolTip="About 5 Mbps upload" Tag="1080p"/>
                    <ComboBoxItem Content="720p ·" ToolTip="About 3 Mbps upload" Tag="720p"/>
                    <ComboBoxItem Content="480p ·" ToolTip="About 1.3 Mbps upload" Tag="480p"/>
                  </ComboBox>
                  <TextBlock x:Name="StreamSetupErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="0,8,0,0"/>
                  <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Left" Content="Save" Style="{StaticResource LiveAction}" Click="StreamSave_Click"/>
                    <Button DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource LiveSubtleAction}" Margin="6,0,0,0" Click="StreamCancel_Click"/>
                    <Button Content="Get key" Style="{StaticResource LiveSubtleAction}" HorizontalAlignment="Right" Click="OpenYouTubeStudio_Click"
                            ToolTip="Opens YouTube Studio. Choose Go live › Stream, then copy the stream key."/>
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource LiveCard}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Video &amp; background" Style="{StaticResource SectionTitle}"/>
                <StackPanel x:Name="VideoOptionsPanel" IsEnabled="False">
                  <TextBlock Text="Quality" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                  <ComboBox x:Name="VideoQualityCombo" SelectedIndex="1" AutomationProperties.Name="Video quality">
                    <ComboBoxItem Content="HD &#183; 720p" Tag="720"/><ComboBoxItem Content="Full HD &#183; 1080p" Tag="1080"/>
                  </ComboBox>
                  <TextBlock Text="Background" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                  <ComboBox x:Name="VideoBackgroundCombo" SelectedIndex="0" SelectionChanged="VideoBackground_Changed" AutomationProperties.Name="Video background">
                    <ComboBoxItem Content="Original room" Tag="0"/><ComboBoxItem Content="Soft room blur" Tag="1"/>
                    <ComboBoxItem Content="Daylight office" Tag="2"/><ComboBoxItem Content="Reading room" Tag="3"/>
                    <ComboBoxItem Content="Saved photo from phone" Tag="4"/><ComboBoxItem Content="My captured room" Tag="6"/>
                  </ComboBox>
                  <CheckBox x:Name="NaturalBackgroundToggle" Content="Natural blending" Checked="NaturalBackground_Changed" Unchecked="NaturalBackground_Changed" Style="{StaticResource SwitchToggle}" IsChecked="True" Margin="0,12,0,0"
                    ToolTip="Matches room lighting, adds lens depth and subtle camera grain, and blends light at the outline."/>
                  <Button x:Name="ApplyVideoOptionsButton" Content="Apply quality" Click="ApplyVideoOptions_Click" Style="{StaticResource LiveAction}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                  <Expander Header="Background carousel" Foreground="{DynamicResource Text}" Margin="0,10,0,0">
                    <StackPanel Margin="0,8,0,0">
                      <ListBox x:Name="BackgroundPlaylistBox" AutomationProperties.Name="Background rotation order" MinHeight="42" MaxHeight="106"/>
                      <WrapPanel Margin="0,6,0,0">
                        <Button Content="Add" Style="{StaticResource LiveAction}" Click="CarouselAdd_Click" ToolTip="Add the background from the dropdown above"/>
                        <Button Content="Up" Style="{StaticResource LiveSubtleAction}" Click="CarouselUp_Click"/>
                        <Button Content="Down" Style="{StaticResource LiveSubtleAction}" Click="CarouselDown_Click"/>
                        <Button Content="Remove" Style="{StaticResource LiveSubtleAction}" Click="CarouselRemove_Click"/>
                      </WrapPanel>
                      <WrapPanel Margin="0,6,0,8">
                        <Button Content="Previous" Style="{StaticResource LiveAction}" Click="CarouselPrevious_Click" Margin="0,0,6,0"/>
                        <Button Content="Next" Style="{StaticResource LiveAction}" Click="CarouselNext_Click" Margin="0,0,6,0"/>
                        <Button Content="Show selected" Style="{StaticResource LiveSubtleAction}" Click="CarouselShow_Click" ToolTip="Apply the selected background to the current scene"/>
                      </WrapPanel>
                      <CheckBox x:Name="AutoBackgroundToggle" Content="Auto rotate" Style="{StaticResource SwitchToggle}" Checked="CarouselAuto_Changed" Unchecked="CarouselAuto_Changed"/>
                      <TextBlock Text="Time per background" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                      <ComboBox x:Name="BackgroundIntervalCombo" AutomationProperties.Name="Time per background" SelectionChanged="CarouselInterval_Changed">
                        <ComboBoxItem Tag="10" Content="10 seconds"/><ComboBoxItem Tag="15" Content="15 seconds"/>
                        <ComboBoxItem Tag="30" Content="30 seconds"/><ComboBoxItem Tag="60" Content="1 minute"/>
                        <ComboBoxItem Tag="120" Content="2 minutes"/><ComboBoxItem Tag="300" Content="5 minutes"/>
                      </ComboBox>
                    </StackPanel>
                  </Expander>
                </StackPanel>
                <TextBlock x:Name="VideoOptionsStatus" Text="Connect a phone" Style="{StaticResource LiveStatus}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <!-- screen share -->
            <Border Style="{StaticResource LiveCard}" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel>
                  <Ellipse x:Name="ShareDot" Width="8" Height="8" Fill="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Text="Screen share" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="ShareStatusText" Style="{StaticResource LiveStatus}" Margin="0,4,0,0"
                           Text=""/>
                <WrapPanel x:Name="ShareIdlePanel" Margin="0,12,0,0">
                  <Button Content="Choose source…" Style="{StaticResource LiveAction}" Click="SharePick_Click" Margin="0,0,8,0"
                          ToolTip="Choose a screen or a window"/>
                  <Button x:Name="ShareMonitorButton" Content="Entire screen" Style="{StaticResource LiveAction}" Click="ShareMonitor_Click"
                          ToolTip="Share the main screen right away"/>
                </WrapPanel>
                <StackPanel x:Name="ShareActivePanel" Margin="0,12,0,0" Visibility="Collapsed">
                  <WrapPanel>
                    <Button Content="Change…" Style="{StaticResource LiveAction}" Click="SharePick_Click" Margin="0,0,8,0"/>
                    <Button Content="Stop sharing" Style="{StaticResource LiveSubtleAction}" Click="ShareStop_Click"/>
                  </WrapPanel>
                </StackPanel>
                <Expander Header="Camera bubble" Margin="0,10,0,0" Foreground="{DynamicResource Text}" ToolTip="Open the phone camera to show a bubble.">
                  <StackPanel Margin="0,8,0,0">
                    <CheckBox x:Name="PreviewBubbleToggle" Content="Preview &amp; meetings" AutomationProperties.Name="Camera bubble in preview &amp; meetings" Style="{StaticResource SwitchToggle}" Checked="BubbleVisibility_Changed" Unchecked="BubbleVisibility_Changed" Margin="0,0,0,8"/>
                    <CheckBox x:Name="RecordingBubbleToggle" Content="Recordings" AutomationProperties.Name="Camera bubble in recordings" Style="{StaticResource SwitchToggle}" Checked="BubbleVisibility_Changed" Unchecked="BubbleVisibility_Changed" Margin="0,0,0,8"/>
                    <CheckBox x:Name="StreamBubbleToggle" Content="Live streams" AutomationProperties.Name="Camera bubble in live streams" Style="{StaticResource SwitchToggle}" Checked="BubbleVisibility_Changed" Unchecked="BubbleVisibility_Changed"/>
                    <TextBlock Text="Size" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="BubbleSmall" Style="{StaticResource Segment}" GroupName="bubble" Content="Small" MinWidth="64" Checked="Bubble_Checked"/>
                        <RadioButton x:Name="BubbleMedium" Style="{StaticResource Segment}" GroupName="bubble" Content="Medium" MinWidth="64" Checked="Bubble_Checked"/>
                        <RadioButton x:Name="BubbleLarge" Style="{StaticResource Segment}" GroupName="bubble" Content="Large" MinWidth="64" Checked="Bubble_Checked"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <!-- pairing (hidden while a phone is connected) -->
            <Border x:Name="PairCard" Style="{StaticResource LiveCard}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Connect a phone" Style="{StaticResource SectionTitle}"/>
                <DockPanel Margin="0,12,0,0">
                  <Border DockPanel.Dock="Left" Background="White" CornerRadius="10" Padding="6" Width="124" Height="124">
                    <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Pairing QR code"/>
                  </Border>
                  <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" Text="Scan with CamStudio Pro."/>
                    <TextBlock x:Name="AddressText" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource TextDim}"
                               Margin="0,8,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="Type this address on the phone if it isn't listed"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock x:Name="NetworkErrorText" Style="{StaticResource Caption}" Foreground="{DynamicResource Danger}" Margin="0,10,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Border>

            <!-- microphone -->
            <Border Style="{StaticResource LiveCard}" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="Microphone" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                  <Border Height="4" CornerRadius="2" Background="{DynamicResource Track}" Width="90" HorizontalAlignment="Right" VerticalAlignment="Center"
                          ToolTip="Phone microphone level">
                    <Border x:Name="AudioMeter" Height="4" CornerRadius="2" Background="{DynamicResource Good}" HorizontalAlignment="Left" Width="0"/>
                  </Border>
                </DockPanel>

                <TextBlock Text="Play through" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                <ComboBox x:Name="AudioOutputCombo" AutomationProperties.Name="Phone audio output device" SelectionChanged="AudioOutput_Changed"
                          ToolTip="Pick a virtual cable (e.g. VB-CABLE “CABLE Input”), then choose “CABLE Output” as the mic in your meeting app."/>

                <Border Style="{StaticResource Divider}"/>
                <CheckBox x:Name="VoiceEnhancementToggle" Style="{StaticResource SwitchToggle}" Content="Voice enhancement"
                          Checked="VoiceEnhancement_Changed" Unchecked="VoiceEnhancement_Changed"
                          ToolTip="Removes background noise and evens out your voice. Applies to live audio and recordings."/>
                <Grid x:Name="VoiceEnhancementOptionsPanel" Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="Noise reduction" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                  <ComboBox x:Name="NoiseReductionCombo" Grid.Row="1" SelectedIndex="1" AutomationProperties.Name="Noise reduction strength"
                            SelectionChanged="VoiceEnhancement_Changed">
                    <ComboBoxItem Content="Low"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Strong"/>
                  </ComboBox>
                  <TextBlock Grid.Column="2" Text="Voice" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                  <ComboBox x:Name="VoicePresetCombo" Grid.Column="2" Grid.Row="1" SelectedIndex="0" AutomationProperties.Name="Voice preset"
                            SelectionChanged="VoiceEnhancement_Changed">
                    <ComboBoxItem Content="Natural"/><ComboBoxItem Content="Broadcast"/>
                  </ComboBox>
                  <CheckBox x:Name="AutomaticVoiceVolumeToggle" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource SwitchToggle}" Margin="0,12,0,0"
                            Content="Automatic volume" Checked="VoiceEnhancement_Changed" Unchecked="VoiceEnhancement_Changed"/>
                </Grid>
                <TextBlock x:Name="VoiceEnhancementStatusText" Style="{StaticResource LiveStatus}" Margin="0,10,0,0"/>
                <Expander Header="Virtual microphone" Foreground="{DynamicResource Text}" Margin="0,10,0,0">
                  <StackPanel Margin="0,8,0,0">
                    <CheckBox x:Name="StudioMicToggle" Content="Show virtual mic" Style="{StaticResource SwitchToggle}" Checked="StudioMic_Changed" Unchecked="StudioMic_Changed"/>
                    <CheckBox x:Name="StudioMicFollow" Content="Follow phone microphone" Style="{StaticResource SwitchToggle}" Checked="StudioMic_Changed" Unchecked="StudioMic_Changed" Margin="0,8,0,0"
                              ToolTip="Show the graphic while the phone mic is available and unmuted."/>
                    <TextBlock Text="Label" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                    <TextBox x:Name="StudioMicLabel" MaxLength="60" AutomationProperties.Name="Microphone label" TextChanged="StudioMic_Changed"/>
                    <Expander Header="Label styling" Margin="0,8,0,0">
                      <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Font" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="StudioLabelFont" SelectedIndex="0" AutomationProperties.Name="Label font" SelectionChanged="StudioMic_Changed">
                          <ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Georgia"/>
                        </ComboBox>
                        <TextBlock Text="Text size" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                        <ComboBox x:Name="StudioLabelSize" SelectedIndex="1" AutomationProperties.Name="Label text size" SelectionChanged="StudioMic_Changed">
                          <ComboBoxItem Content="Small"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Large"/>
                        </ComboBox>
                        <CheckBox x:Name="StudioLabelBold" Content="Bold text" Style="{StaticResource SwitchToggle}" Checked="StudioMic_Changed" Unchecked="StudioMic_Changed" Margin="0,8,0,8"/>
                        <Button x:Name="StudioLabelInk" Tag="ink" Style="{StaticResource LiveAction}" Click="StudioLabelColor_Click" Margin="0,0,0,6"/>
                        <Button x:Name="StudioLabelLeft" Tag="left" Style="{StaticResource LiveAction}" Click="StudioLabelColor_Click" Margin="0,0,0,6"/>
                        <Button x:Name="StudioLabelRight" Tag="right" Style="{StaticResource LiveAction}" Click="StudioLabelColor_Click"/>
                      </StackPanel>
                    </Expander>
                    <TextBlock Text="Mic style" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                    <ComboBox x:Name="StudioMicStyleCombo" AutomationProperties.Name="Virtual microphone style" SelectionChanged="StudioMic_Changed">
                      <ComboBoxItem Content="Mic 1 - Metal grille"/>
                      <ComboBoxItem Content="Mic 2 - Foam windscreen"/>
                    </ComboBox>
                    <TextBlock Text="Size" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                    <ComboBox x:Name="StudioMicSize" AutomationProperties.Name="Virtual microphone size" SelectionChanged="StudioMic_Changed">
                      <ComboBoxItem Content="Small"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Large"/>
                    </ComboBox>
                    <CheckBox x:Name="StudioMicRecord" Content="Include in recordings" Style="{StaticResource SwitchToggle}" Checked="StudioMic_Changed" Unchecked="StudioMic_Changed" Margin="0,8,0,0"/>
                    <CheckBox x:Name="StudioMicStream" Content="Include in live streams" Style="{StaticResource SwitchToggle}" Checked="StudioMic_Changed" Unchecked="StudioMic_Changed" Margin="0,8,0,0"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <!-- beauty -->
            <Border Style="{StaticResource LiveCard}">
              <StackPanel>
                <TextBlock Text="Beauty" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="BeautyStatusText" Style="{StaticResource LiveStatus}" Margin="0,4,0,0" Text="Connect a phone"/>
                <StackPanel x:Name="BeautyControlsPanel" IsEnabled="False" Margin="0,12,0,0">
                  <CheckBox x:Name="TouchUpToggle" Style="{StaticResource SwitchToggle}" Content="Touch up appearance"
                            Checked="TouchUp_Changed" Unchecked="TouchUp_Changed"/>
                  <StackPanel x:Name="TouchUpStrengthPanel" IsEnabled="False" Margin="0,8,0,12">
                    <TextBlock Text="Strength" Style="{StaticResource Caption}"/>
                    <Slider x:Name="TouchUpStrengthSlider" Minimum="1" Maximum="100" Value="35" TickFrequency="1" IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True" MinHeight="28" ValueChanged="TouchUpStrength_Changed" AutomationProperties.Name="Touch-up strength"/>
                  </StackPanel>
                  <CheckBox x:Name="BeautyEnabledToggle" Style="{StaticResource SwitchToggle}" Content="Beauty effects"
                            Checked="BeautyEnabled_Changed" Unchecked="BeautyEnabled_Changed"/>
                  <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="BeautyOriginalButton" Content="Hold original" Style="{StaticResource LiveAction}" Margin="0,0,8,0"
                            ToolTip="Hold to compare with the unedited picture"
                            PreviewMouseLeftButtonDown="BeautyOriginal_Down" PreviewMouseLeftButtonUp="BeautyOriginal_Up"
                            LostMouseCapture="BeautyOriginal_LostCapture" PreviewKeyDown="BeautyOriginal_KeyDown" PreviewKeyUp="BeautyOriginal_KeyUp"
                            LostKeyboardFocus="BeautyOriginal_LostFocus"/>
                    <Button Content="Reset" Style="{StaticResource LiveSubtleAction}" Click="ResetBeauty_Click" ToolTip="Set every slider to 0 and turn beauty off"/>
                  </WrapPanel>
                  <Button x:Name="BeautyAdjustToggle" Content="Show adjustments" Style="{StaticResource LiveSubtleAction}" HorizontalAlignment="Left"
                          Margin="0,12,0,0" Click="BeautyAdjustToggle_Click"/>
                  <StackPanel x:Name="BeautySlidersPanel" Margin="0,4,0,0" Visibility="Collapsed"
                              ToolTip="Positive values narrow widths and lengthen or lift features."/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ============ EDITOR ============ -->
      <ContentControl x:Name="EditorHost" Grid.Row="1" Visibility="Collapsed" Focusable="False"/>

      <!-- ============ SETTINGS ============ -->
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,0,24,32" MaxWidth="760" HorizontalAlignment="Left" Width="760">

          <TextBlock Text="Appearance" Style="{StaticResource SettingsHeading}" Margin="2,0,0,10"/>
          <Border Style="{StaticResource CardBorder}">
            <Grid Style="{StaticResource SettingRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Theme" FontSize="13.5" FontWeight="SemiBold"/>
                <TextBlock Text="System follows your Windows setting." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="ThemeSystemRadio" Style="{StaticResource Segment}" GroupName="theme" Content="System" Checked="Theme_Checked"/>
                  <RadioButton x:Name="ThemeLightRadio" Style="{StaticResource Segment}" GroupName="theme" Content="Light" Checked="Theme_Checked"/>
                  <RadioButton x:Name="ThemeDarkRadio" Style="{StaticResource Segment}" GroupName="theme" Content="Dark" Checked="Theme_Checked"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <TextBlock Text="Startup" Style="{StaticResource SettingsHeading}"/>
          <Border Style="{StaticResource CardBorder}" Padding="16,6">
            <StackPanel>
              <Grid Style="{StaticResource SettingRow}">
                <CheckBox x:Name="StartWithWindowsToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                          Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed">
                  <StackPanel>
                    <TextBlock Text="Start with Windows" FontSize="13.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StartupNoteText" Text="Opens in the notification area so phones can reconnect." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                  </StackPanel>
                </CheckBox>
              </Grid>
              <Border Style="{StaticResource Divider}" Margin="0,6"/>
              <Grid Style="{StaticResource SettingRow}">
                <CheckBox x:Name="StartMinimizedToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                          Checked="StartMinimized_Changed" Unchecked="StartMinimized_Changed">
                  <TextBlock Text="Open in the notification area" FontSize="13.5" FontWeight="SemiBold"/>
                </CheckBox>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="Phones" Style="{StaticResource SettingsHeading}"/>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="New pairing code" Style="{StaticResource BaseButton}" Click="NewPairCode_Click"
                        ToolTip="Old QR codes stop working. Trusted phones stay trusted."/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Trusted phones" FontSize="13.5" FontWeight="SemiBold"/>
                  <TextBlock x:Name="NoTrustedText" Style="{StaticResource Caption}" Margin="0,2,0,0" Text="None yet."/>
                </StackPanel>
              </DockPanel>
              <StackPanel x:Name="TrustedList" Margin="0,4,0,0"/>
              <Border Style="{StaticResource Divider}"/>
              <TextBlock Text="USB cable" FontSize="13.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="UsbStatusText" Style="{StaticResource Body}" Margin="0,2,0,0" Text="Looking for adb…"/>
              <TextBlock x:Name="UsbDetailText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>

          <TextBlock Text="About" Style="{StaticResource SettingsHeading}"/>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <Button x:Name="VirtualCameraButton" Content="Enable camera for Zoom" Click="EnableVirtualCamera_Click" HorizontalAlignment="Left" Margin="0,8,0,4"/>
              <TextBlock x:Name="VirtualCameraStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock x:Name="VersionText" Text="CamStudio Pro" FontSize="13.5" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Video and audio stay on your local network."/>
              <WrapPanel Margin="0,10,0,0">
                <Button Content="Open recordings folder" Style="{StaticResource LinkButton}" Click="OpenRecordings_Click" Margin="0,0,16,0"/>
                <Button Content="Third-party licenses" Style="{StaticResource LinkButton}" Click="Licenses_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
