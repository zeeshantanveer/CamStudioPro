<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light theme colour tokens. Keys must match Themes/Dark.xaml. -->
  <Color x:Key="GroundColor">#F4F5F7</Color>
  <Color x:Key="PanelColor">#FFFFFF</Color>
  <Color x:Key="CardColor">#FFFFFF</Color>
  <Color x:Key="CardRaisedColor">#F7F8FA</Color>
  <Color x:Key="HoverColor">#EEF0F3</Color>
  <Color x:Key="SelectedColor">#E4E7EC</Color>
  <Color x:Key="LineColor">#E3E5EA</Color>
  <Color x:Key="LineStrongColor">#CBD0D7</Color>
  <Color x:Key="TextColor">#14161B</Color>
  <Color x:Key="TextSoftColor">#3A3F48</Color>
  <Color x:Key="TextDimColor">#5E6571</Color>
  <Color x:Key="AccentColor">#FFB020</Color>
  <Color x:Key="AccentHoverColor">#F2A100</Color>
  <Color x:Key="OnAccentColor">#1A1200</Color>
  <Color x:Key="AccentTextColor">#8F5400</Color>
  <Color x:Key="GoodColor">#1A7F45</Color>
  <Color x:Key="GoodBgColor">#E2F4E9</Color>
  <Color x:Key="LiveColor">#D92D20</Color>
  <Color x:Key="DangerColor">#B42318</Color>
  <Color x:Key="DangerBgColor">#FDEDEB</Color>
  <Color x:Key="DangerLineColor">#F4C3BE</Color>
  <Color x:Key="TrackColor">#D3D7DE</Color>
  <Color x:Key="InputBgColor">#FFFFFF</Color>
  <Color x:Key="ThumbFillColor">#FFFFFF</Color>
  <Color x:Key="ScrimColor">#80000000</Color>
  <Color x:Key="PreviewBgColor">#000000</Color>
  <Color x:Key="TimelineBgColor">#ECEEF2</Color>
  <Color x:Key="TrackHeaderColor">#F7F8FA</Color>
  <Color x:Key="ClipVideoColor">#5C7CFA</Color>
  <Color x:Key="ClipAudioColor">#40C057</Color>
  <Color x:Key="ClipMusicColor">#1098AD</Color>
  <Color x:Key="ClipTitleColor">#BE4BDB</Color>
  <Color x:Key="ClipTextColor">#FFFFFF</Color>
  <Color x:Key="PlayheadColor">#E03131</Color>
  <SolidColorBrush x:Key="Ground" Color="{StaticResource GroundColor}"/>
  <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}"/>
  <SolidColorBrush x:Key="CardRaised" Color="{StaticResource CardRaisedColor}"/>
  <SolidColorBrush x:Key="Hover" Color="{StaticResource HoverColor}"/>
  <SolidColorBrush x:Key="Selected" Color="{StaticResource SelectedColor}"/>
  <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
  <SolidColorBrush x:Key="LineStrong" Color="{StaticResource LineStrongColor}"/>
  <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="TextSoft" Color="{StaticResource TextSoftColor}"/>
  <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}"/>
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
  <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}"/>
  <SolidColorBrush x:Key="AccentText" Color="{StaticResource AccentTextColor}"/>
  <SolidColorBrush x:Key="Good" Color="{StaticResource GoodColor}"/>
  <SolidColorBrush x:Key="GoodBg" Color="{StaticResource GoodBgColor}"/>
  <SolidColorBrush x:Key="Live" Color="{StaticResource LiveColor}"/>
  <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="DangerBg" Color="{StaticResource DangerBgColor}"/>
  <SolidColorBrush x:Key="DangerLine" Color="{StaticResource DangerLineColor}"/>
  <SolidColorBrush x:Key="Track" Color="{StaticResource TrackColor}"/>
  <SolidColorBrush x:Key="InputBg" Color="{StaticResource InputBgColor}"/>
  <SolidColorBrush x:Key="ThumbFill" Color="{StaticResource ThumbFillColor}"/>
  <SolidColorBrush x:Key="Scrim" Color="{StaticResource ScrimColor}"/>
  <SolidColorBrush x:Key="PreviewBg" Color="{StaticResource PreviewBgColor}"/>
  <SolidColorBrush x:Key="TimelineBg" Color="{StaticResource TimelineBgColor}"/>
  <SolidColorBrush x:Key="TrackHeader" Color="{StaticResource TrackHeaderColor}"/>
  <SolidColorBrush x:Key="ClipVideo" Color="{StaticResource ClipVideoColor}"/>
  <SolidColorBrush x:Key="ClipAudio" Color="{StaticResource ClipAudioColor}"/>
  <SolidColorBrush x:Key="ClipMusic" Color="{StaticResource ClipMusicColor}"/>
  <SolidColorBrush x:Key="ClipTitle" Color="{StaticResource ClipTitleColor}"/>
  <SolidColorBrush x:Key="ClipText" Color="{StaticResource ClipTextColor}"/>
  <SolidColorBrush x:Key="Playhead" Color="{StaticResource PlayheadColor}"/>
</ResourceDictionary>
