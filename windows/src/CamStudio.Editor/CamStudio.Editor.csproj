<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CamStudio.Editor</RootNamespace>
    <AssemblyName>CamStudio.Editor</AssemblyName>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- RNNoise speech model for "Noise reduction" (arnndn); see Assets/rnnoise/NOTICE.txt. -->
    <Content Include="Assets\rnnoise\sh.rnnn" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\rnnoise\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- test hooks used by the visual harness -->
    <InternalsVisibleTo Include="EditorHarness" />
  </ItemGroup>

</Project>
