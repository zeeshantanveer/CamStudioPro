<UserControl x:Class="CamStudio.Editor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CamStudio.Editor"
             Focusable="True" FocusVisualStyle="{x:Null}" AllowDrop="True"
             TextElement.Foreground="{DynamicResource Text}" FontFamily="{DynamicResource Sans}"
             Background="{DynamicResource Ground}">
  <UserControl.Resources>
    <Style x:Key="BinItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="6" Margin="0,0,0,2"
                    BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="Background" Value="{DynamicResource Line}"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="220"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===== toolbar ===== -->
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,8">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Style="{DynamicResource IconButton}" Content="&#xE7C3;" ToolTip="New project (Ctrl+N)" AutomationProperties.Name="New project" Click="New_Click"/>
          <Button Style="{DynamicResource IconButton}" Content="&#xE8E5;" ToolTip="Open project (Ctrl+O)" AutomationProperties.Name="Open project" Click="Open_Click"/>
          <Button Style="{DynamicResource IconButton}" Content="&#xE74E;" ToolTip="Save project (Ctrl+S)" AutomationProperties.Name="Save project" Click="Save_Click"/>
          <Border Style="{StaticResource ToolSeparator}"/>
          <Button x:Name="UndoButton" Style="{DynamicResource IconButton}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" Click="Undo_Click"/>
          <Button x:Name="RedoButton" Style="{DynamicResource IconButton}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" Click="Redo_Click"/>
          <Border Style="{StaticResource ToolSeparator}"/>
          <Button Style="{DynamicResource GhostButton}" ToolTip="Split the clip at the playhead (S)" Click="Split_Click" AutomationProperties.Name="Split">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{DynamicResource Icon}" Text="&#xE8C6;" FontSize="14"/>
              <TextBlock Text="Split" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="DeleteButton" Style="{DynamicResource GhostButton}" ToolTip="Delete the selected clip (Del)" Click="Delete_Click" AutomationProperties.Name="Delete">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{DynamicResource Icon}" Text="&#xE74D;" FontSize="14"/>
              <TextBlock Text="Delete" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>
          <Button Style="{DynamicResource GhostButton}" ToolTip="Add a title at the playhead (T)" Click="AddTitle_Click" AutomationProperties.Name="Add title">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{DynamicResource Icon}" Text="&#xE8D2;" FontSize="14"/>
              <TextBlock Text="Title" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <TextBlock x:Name="ProjectNameText" Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" MaxWidth="260"/>
          <Button x:Name="ExportButton" Style="{DynamicResource PrimaryButton}" Click="Export_Click" ToolTip="Render the timeline to an MP4 file">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{DynamicResource Icon}" Text="&#xE898;" FontSize="14"/>
              <TextBlock Text="Export" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== media bin · preview · properties ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" MinWidth="180"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="320"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="280" MinWidth="220"/>
      </Grid.ColumnDefinitions>

      <!-- media bin -->
      <DockPanel Background="{DynamicResource Panel}">
        <DockPanel DockPanel.Dock="Top" Margin="14,12,8,8" LastChildFill="False">
          <TextBlock Text="Media" Style="{DynamicResource SectionTitle}" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE8B7;" ToolTip="Add recordings from Videos\CamStudio Pro"
                  AutomationProperties.Name="Add recordings" Click="AddRecordings_Click"/>
          <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE710;" ToolTip="Import media (Ctrl+I)"
                  AutomationProperties.Name="Import media" Click="Import_Click"/>
        </DockPanel>
        <Grid>
          <ListBox x:Name="BinList" Background="Transparent" BorderThickness="0" Padding="8,0,8,8"
                   ItemContainerStyle="{StaticResource BinItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Media"
                   PreviewMouseLeftButtonDown="Bin_PreviewMouseDown" PreviewMouseMove="Bin_PreviewMouseMove"
                   MouseDoubleClick="Bin_DoubleClick" KeyDown="Bin_KeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type local:BinItem}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="72" Height="40" CornerRadius="5" Background="{DynamicResource CardRaised}" ClipToBounds="True">
                    <Grid>
                      <TextBlock Text="{Binding Glyph}" Style="{DynamicResource Icon}" Foreground="{DynamicResource TextDim}"/>
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                    <TextBlock Text="{Binding Detail}" Style="{DynamicResource Caption}" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{DynamicResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE710;"
                          ToolTip="Add to timeline" AutomationProperties.Name="Add to timeline" Click="BinAdd_Click"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="BinEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" IsHitTestVisible="False">
            <TextBlock Style="{DynamicResource Icon}" Text="&#xE8B5;" FontSize="28" Foreground="{DynamicResource TextDim}"/>
            <TextBlock Text="Drop videos, images or music here" Style="{DynamicResource Caption}" TextAlignment="Center" Margin="0,10,0,0"/>
          </StackPanel>
        </Grid>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource Line}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

      <!-- preview -->
      <DockPanel Grid.Column="2" Margin="16,14,16,10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
          <TextBlock x:Name="TimecodeText" DockPanel.Dock="Left" FontFamily="{DynamicResource Mono}" FontSize="13" VerticalAlignment="Center"
                     Text="00:00:00" MinWidth="90"/>
          <TextBlock x:Name="DurationText" DockPanel.Dock="Right" FontFamily="{DynamicResource Mono}" FontSize="13" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextDim}" Text="00:00:00" MinWidth="90" TextAlignment="Right"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{DynamicResource IconButton}" Content="&#xE892;" ToolTip="Previous frame (←)" AutomationProperties.Name="Previous frame" Click="PrevFrame_Click"/>
            <Button x:Name="PlayButton" Style="{DynamicResource PrimaryButton}" Width="44" Height="36" Padding="0" Margin="8,0" Click="Play_Click"
                    ToolTip="Play / pause (Space)" AutomationProperties.Name="Play">
              <TextBlock x:Name="PlayGlyph" Style="{DynamicResource Icon}" Text="&#xE768;" FontSize="14"/>
            </Button>
            <Button Style="{DynamicResource IconButton}" Content="&#xE893;" ToolTip="Next frame (→)" AutomationProperties.Name="Next frame" Click="NextFrame_Click"/>
          </StackPanel>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{DynamicResource Caption}" TextAlignment="Center" Margin="0,8,0,0"
                   Visibility="Collapsed"/>
        <Border Background="{DynamicResource PreviewBg}" CornerRadius="10" ClipToBounds="True" MouseLeftButtonDown="Preview_MouseDown">
          <Grid>
            <Viewbox Stretch="Uniform">
              <Grid x:Name="Stage" Width="1920" Height="1080" Background="#000000" ClipToBounds="True">
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform"
                              Volume="1" MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed"/>
                <Image x:Name="StillImage" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image x:Name="ExactFrame" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Grid x:Name="TitleLayer" IsHitTestVisible="False"/>
              </Grid>
            </Viewbox>
            <MediaElement x:Name="MusicPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Width="0" Height="0"
                          MediaOpened="Music_MediaOpened"/>
            <!-- plays the cleaned (noise-reduced) audio of the current video clip instead of its own sound -->
            <MediaElement x:Name="CleanPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Width="0" Height="0"
                          MediaOpened="Clean_MediaOpened"/>
            <StackPanel x:Name="PreviewEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
              <TextBlock x:Name="PreviewEmptyIcon" Style="{DynamicResource Icon}" Text="&#xE714;" FontSize="34" Foreground="#9AA0AB"/>
              <TextBlock x:Name="PreviewEmptyText" Text="Add clips to the timeline to start editing" Foreground="#C9CDD4" FontSize="13"
                         Margin="0,12,0,0" TextAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>
      </DockPanel>

      <GridSplitter Grid.Column="3" Width="1" Background="{DynamicResource Line}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

      <!-- properties -->
      <DockPanel Grid.Column="4" Background="{DynamicResource Panel}">
        <TextBlock x:Name="PropertiesTitle" DockPanel.Dock="Top" Text="Project" Style="{DynamicResource SectionTitle}" Margin="16,14,16,4"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="PropertiesHost" Margin="16,4,16,16"/>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

    <!-- ===== timeline ===== -->
    <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="14,6,12,4" LastChildFill="False">
          <TextBlock Text="Timeline" Style="{DynamicResource SectionTitle}" VerticalAlignment="Center"/>
          <TextBlock Text="Click a clip to select · drag edges to trim · S split · Del delete · Tab next clip" Style="{DynamicResource Caption}"
                     VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="NoWrap"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{DynamicResource IconButton}" Content="&#xE71F;" Width="28" Height="28" FontSize="12" ToolTip="Zoom out (Ctrl+wheel)"
                    AutomationProperties.Name="Zoom out" Click="ZoomOut_Click"/>
            <Slider x:Name="ZoomSlider" Width="130" Minimum="0" Maximum="7" Value="2.6" VerticalAlignment="Center" Margin="4,0"
                    AutomationProperties.Name="Timeline zoom" ValueChanged="Zoom_Changed"/>
            <Button Style="{DynamicResource IconButton}" Content="&#xE8A3;" Width="28" Height="28" FontSize="12" ToolTip="Zoom in (Ctrl+wheel)"
                    AutomationProperties.Name="Zoom in" Click="ZoomIn_Click"/>
            <Button Style="{DynamicResource GhostButton}" Content="Fit" MinHeight="28" Padding="10,0" Margin="4,0,0,0" ToolTip="Fit the whole timeline"
                    Click="ZoomFit_Click"/>
          </StackPanel>
        </DockPanel>
        <Grid Height="{x:Static local:TimelineControl.TotalHeightWithScroll}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Canvas x:Name="TrackHeaders" Background="{DynamicResource Panel}"/>
          <ScrollViewer x:Name="TimelineScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                        PreviewMouseWheel="Timeline_PreviewMouseWheel" AllowDrop="True"
                        DragOver="Timeline_DragOver" DragLeave="Timeline_DragLeave" Drop="Timeline_Drop" SizeChanged="TimelineScroll_SizeChanged">
            <local:TimelineControl x:Name="Timeline" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>

    <!-- ===== export panel ===== -->
    <Grid x:Name="ExportOverlay" Grid.RowSpan="4" Background="{DynamicResource Scrim}" Visibility="Collapsed">
      <Border Style="{DynamicResource CardBorder}" Width="460" Padding="22" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <DockPanel LastChildFill="False">
            <TextBlock x:Name="ExportTitleText" Text="Export video" Style="{DynamicResource PageTitle}" FontSize="19"/>
            <Button x:Name="ExportCloseButton" DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE711;"
                    ToolTip="Close" AutomationProperties.Name="Close" Click="ExportClose_Click"/>
          </DockPanel>
          <StackPanel x:Name="ExportForm" Margin="0,14,0,0">
            <TextBlock Text="Format" Style="{DynamicResource Caption}" Margin="0,0,0,6"/>
            <ComboBox x:Name="PresetCombo" AutomationProperties.Name="Format" SelectionChanged="Preset_Changed"/>
            <TextBlock Text="Quality" Style="{DynamicResource Caption}" Margin="0,14,0,6"/>
            <Border Style="{DynamicResource SegmentHost}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="QualityHigh" Style="{DynamicResource Segment}" GroupName="quality" Content="High" ToolTip="Best quality, larger file"/>
                <RadioButton x:Name="QualityStandard" Style="{DynamicResource Segment}" GroupName="quality" Content="Standard" IsChecked="True"/>
                <RadioButton x:Name="QualitySmall" Style="{DynamicResource Segment}" GroupName="quality" Content="Small" ToolTip="Smaller file for sharing"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Loudness" Style="{DynamicResource Caption}" Margin="0,14,0,6"/>
            <Border Style="{DynamicResource SegmentHost}" HorizontalAlignment="Left"
                    ToolTip="Sets the whole export to the platform's loudness (true peak −1 dBTP). Measured first, then applied.">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LoudOff" Style="{DynamicResource Segment}" GroupName="loud" Content="Off" Checked="ExportLoudness_Checked"/>
                <RadioButton x:Name="LoudYouTube" Style="{DynamicResource Segment}" GroupName="loud" Content="YouTube · −14" Checked="ExportLoudness_Checked"/>
                <RadioButton x:Name="LoudPodcast" Style="{DynamicResource Segment}" GroupName="loud" Content="Podcast · −16" Checked="ExportLoudness_Checked"/>
              </StackPanel>
            </Border>
            <StackPanel x:Name="EncoderPanel">
              <TextBlock Text="Encoder" Style="{DynamicResource Caption}" Margin="0,14,0,6"/>
              <ComboBox x:Name="EncoderCombo" AutomationProperties.Name="Encoder"/>
            </StackPanel>
            <TextBlock Text="Save to" Style="{DynamicResource Caption}" Margin="0,14,0,6"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{DynamicResource BaseButton}" Content="Browse…" Margin="8,0,0,0" Click="ExportBrowse_Click"/>
              <TextBox x:Name="ExportPathBox" AutomationProperties.Name="Output file"/>
            </DockPanel>
          </StackPanel>
          <StackPanel x:Name="ExportProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="ExportProgressBar" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="ExportStatusText" Style="{DynamicResource Caption}" Margin="0,8,0,0"/>
          </StackPanel>
          <TextBlock x:Name="ExportErrorText" Style="{DynamicResource Caption}" Foreground="{DynamicResource Danger}" Margin="0,12,0,0" Visibility="Collapsed"/>
          <StackPanel x:Name="ExportButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ExportCancelButton" Style="{DynamicResource BaseButton}" Content="Cancel" Click="ExportCancel_Click"/>
            <Button x:Name="ExportStartButton" Style="{DynamicResource PrimaryButton}" Content="Export" Margin="8,0,0,0" Click="ExportStart_Click"/>
          </StackPanel>
          <StackPanel x:Name="ExportDoneButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Visibility="Collapsed">
            <Button Style="{DynamicResource BaseButton}" Content="Show in folder" Click="ExportShowFolder_Click"/>
            <Button Style="{DynamicResource PrimaryButton}" Content="Open file" Margin="8,0,0,0" Click="ExportOpen_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===== ffmpeg missing ===== -->
    <Grid x:Name="SetupOverlay" Grid.RowSpan="4" Background="{DynamicResource Ground}" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <TextBlock Style="{DynamicResource Icon}" Text="&#xE8B2;" FontSize="26" Foreground="{DynamicResource AccentText}"/>
        </Border>
        <TextBlock Text="FFmpeg is needed for editing" Style="{DynamicResource PageTitle}" FontSize="20" TextAlignment="Center" Margin="0,18,0,0"/>
        <TextBlock Style="{DynamicResource Body}" TextAlignment="Center" Margin="0,8,0,0"
                   Text="Point CamStudio Pro to ffmpeg.exe. ffprobe.exe must be in the same folder."/>
        <Button Style="{DynamicResource PrimaryButton}" Content="Locate ffmpeg.exe…" HorizontalAlignment="Center" Margin="0,20,0,0" Padding="20,0"
                MinHeight="38" Click="LocateFfmpeg_Click"/>
        <Button Style="{DynamicResource LinkButton}" Content="Download FFmpeg" HorizontalAlignment="Center" Margin="0,14,0,0" Click="DownloadFfmpeg_Click"/>
        <TextBlock x:Name="SetupErrorText" Style="{DynamicResource Caption}" Foreground="{DynamicResource Danger}" TextAlignment="Center"
                   Margin="0,10,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
